{
  "name": "@stackdeck/terset",
  "version": "0.3.1",
  "description": "A compact text format for JSON records in LLM prompts. Same data, fewer input tokens.",
  "type": "module",
  "license": "MIT",
  "author": "StackDeck",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://terset.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackdeckhq/terset.git",
    "directory": "packages/terset"
  },
  "bugs": "https://github.com/stackdeckhq/terset/issues",
  "keywords": ["json", "llm", "prompt", "tokens", "table", "encoding"],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": ["dist", "SPEC.md", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
